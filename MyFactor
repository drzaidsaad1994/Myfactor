<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0;font:14px system-ui}img{max-width:100%}[hidden]{display:none!important}</style>
<title>فاكتري</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Noto+Kufi+Arabic:wght@600;700&family=Playfair+Display:ital,wght@0,500;1,600&display=swap">
<style>
/* Layout: one narrow column. Signature line, inputs, live result, worked steps, formula, signature line. */
:root {
  --bg: #eef2f5;
  --surface: #ffffff;
  --surface-2: #f4f7f9;
  --ink: #12202e;
  --ink-soft: #52627a;
  --line: #d5dde5;
  --accent: #0b6b8a;
  --accent-ink: #ffffff;
  --accent-soft: #dff0f6;
  --warn: #8a5300;
  --warn-bg: #fdf1dc;
  --bad: #a3262a;
  --bad-bg: #fbe6e6;
  --art-a: #7fc4d6;
  --art-b: #eba5aa;
  --font-display: "Noto Kufi Arabic", "IBM Plex Sans Arabic", Tahoma, sans-serif;
  --font-body: "IBM Plex Sans Arabic", Tahoma, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e1721;
    --surface: #16232f;
    --surface-2: #1b2b39;
    --ink: #e7eef4;
    --ink-soft: #9db0c2;
    --line: #2a3b4b;
    --accent: #5bbad6;
    --accent-ink: #08212b;
    --accent-soft: #17394a;
    --warn: #f1c27a;
    --warn-bg: #3a2c12;
    --bad: #f3a1a3;
    --bad-bg: #3d1e20;
    --art-a: #2c7a94;
    --art-b: #8a4a56;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e1721;
  --surface: #16232f;
  --surface-2: #1b2b39;
  --ink: #e7eef4;
  --ink-soft: #9db0c2;
  --line: #2a3b4b;
  --accent: #5bbad6;
  --accent-ink: #08212b;
  --accent-soft: #17394a;
  --warn: #f1c27a;
  --warn-bg: #3a2c12;
  --bad: #f3a1a3;
  --bad-bg: #3d1e20;
    --art-a: #2c7a94;
    --art-b: #8a4a56;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  direction: rtl;
  padding-inline: 16px;
  padding-block: 20px 36px;
}
/* Blurred medical backdrop: cross, ECG line, DNA helix, cells, capsule */
.bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
.bg svg { width: 100%; height: 100%; display: block; filter: blur(9px); opacity: 0.6; transform: scale(1.08); }
.bg::after { content: ""; position: absolute; inset: 0; background: var(--bg); opacity: 0.3; }
.bg .a { fill: var(--art-a); }
.bg .b { fill: var(--art-b); }
.bg .sa { stroke: var(--art-a); fill: none; stroke-linecap: round; stroke-linejoin: round; }
.bg .sb { stroke: var(--art-b); fill: none; stroke-linecap: round; stroke-linejoin: round; }
.wrap { max-width: 660px; margin-inline: auto; display: flex; flex-direction: column; gap: 20px; min-width: 0; }

.sign {
  direction: ltr;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: baseline;
  gap: 4px 10px;
  font-family: "Playfair Display", Georgia, "Times New Roman", serif;
  font-size: 1.1rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--ink-soft);
  margin: 0;
}
.sign .name {
  font-size: clamp(1.7rem, 7vw, 2.1rem);
  font-style: italic;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--accent);
}
.sign.top { padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.sign.bottom { padding-top: 16px; border-top: 1px solid var(--line); }

header h1 {
  font-family: var(--font-display);
  font-size: clamp(1.7rem, 6vw, 2.2rem);
  line-height: 1.3;
  margin: 0 0 6px;
  text-wrap: balance;
}
header p { margin: 0; color: var(--ink-soft); max-width: 60ch; }

.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 20px;
  min-width: 0;
}
.panel h2 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  margin: 0 0 14px;
}

.fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field.wide { grid-column: 1 / -1; }
.field label { font-weight: 600; font-size: 0.95rem; }
.field .hint { font-size: 0.82rem; color: var(--ink-soft); margin: 0; }
.field input {
  font: inherit;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 12px;
  width: 100%;
  min-width: 0;
  direction: ltr;
  text-align: right;
}
.field input::placeholder { color: var(--ink-soft); opacity: 0.7; }
.field input:focus-visible,
button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.field input[aria-invalid="true"] { border-color: var(--bad); }

.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; align-items: center; }
button {
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  border-radius: 8px;
  padding: 9px 16px;
  border: 1px solid var(--line);
  background: var(--surface-2);
  color: var(--ink);
}
button:hover { border-color: var(--accent); }
.actions .note { font-size: 0.85rem; color: var(--ink-soft); }

.msgs { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
.msgs:empty { display: none; }
.msg { border-radius: 8px; padding: 9px 12px; font-size: 0.92rem; }
.msg.warn { background: var(--warn-bg); color: var(--warn); }
.msg.bad { background: var(--bad-bg); color: var(--bad); }

/* Result bar stays pinned at the top so it remains visible while the phone keyboard is open */
.resbar { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 8px); z-index: 5; }
.res {
  border-radius: 10px;
  padding: 12px 16px;
  background: var(--accent);
  color: var(--accent-ink);
  display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12px; min-width: 0;
  box-shadow: 0 8px 20px rgba(8, 33, 43, 0.25);
}
.res .lbl { display: flex; flex-direction: column; min-width: 0; }
.res .label { font-size: 0.98rem; font-weight: 600; }
.res .value {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 9vw, 2.6rem);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  direction: ltr;
  text-align: left;
}
.res .sub { font-size: 0.82rem; opacity: 0.85; }
button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

ol.steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; counter-reset: s; }
ol.steps li {
  counter-increment: s;
  display: grid;
  grid-template-columns: 1.7rem 1fr;
  gap: 10px;
  align-items: start;
}
ol.steps li::before {
  content: counter(s);
  width: 1.7rem; height: 1.7rem;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600; font-size: 0.85rem;
  display: grid; place-items: center;
}
.steps .what { display: block; font-weight: 600; }
.eq { display: block; direction: ltr; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-soft); overflow-wrap: anywhere; }

.formula { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
.formula b { display: block; margin-bottom: 2px; }
.formula span { color: var(--ink-soft); font-size: 0.93rem; }

@media (max-width: 520px) {
  .fields { gap: 8px; }
  .field label { font-size: 0.88rem; }
  .field input { padding: 10px 8px; }
  .panel { padding: 16px; }
}
</style>

</head>
<body>
<div class="bg" aria-hidden="true">
  <svg viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <path class="b" d="M-40 -120h80v80h80v80h-80v80h-80v-80h-80v-80h80z" transform="translate(190 210) rotate(-12) scale(1.15)"/>
    <path class="b" d="M-40 -120h80v80h80v80h-80v80h-80v-80h-80v-80h80z" transform="translate(1040 760) rotate(14) scale(0.8)"/>
    <path class="sa" stroke-width="12" d="M0 640 H280 l40 -120 l60 260 l50 -190 l30 50 H620 l40 -90 l50 200 l40 -110 H1200"/>
    <path class="sa" stroke-width="14" d="M930 60 C1050 170 1050 270 930 380 S810 560 930 680"/>
    <path class="sb" stroke-width="14" d="M1040 60 C920 170 920 270 1040 380 S1160 560 1040 680"/>
    <g class="sa" stroke-width="8">
      <path d="M965 118 H1005"/><path d="M948 200 H1022"/><path d="M958 290 H1012"/><path d="M968 380 H1002"/><path d="M1010 470 H1066"/><path d="M958 560 H1014"/>
    </g>
    <circle class="a" cx="520" cy="150" r="58"/>
    <circle class="b" cx="640" cy="260" r="34"/>
    <circle class="a" cx="90" cy="520" r="44"/>
    <circle class="b" cx="430" cy="820" r="62"/>
    <circle class="a" cx="760" cy="820" r="30"/>
    <circle class="a" cx="1130" cy="460" r="38"/>
    <g transform="translate(300 400) rotate(-35)">
      <rect class="a" x="-100" y="-38" width="200" height="76" rx="38"/>
      <path class="b" d="M0 -38 H62 a38 38 0 0 1 0 76 H0 z"/>
    </g>
  </svg>
</div>

<div class="wrap" dir="rtl" lang="ar">
  <p class="sign top"><span>Designed by:</span> <span class="name">Dr.Zaid Saad</span></p>

  <header>
    <h1>فاكتري</h1>
    <p>أدخل تسلسلك وعدد الطلبة ومعدلك، ليظهر معدل أساس المفاضلة (30٪ للتسلسل والمعدل) فوراً.</p>
  </header>

  <section class="resbar" aria-label="النتيجة">
    <div class="res">
      <div class="lbl">
        <span class="label">معدل أساس المفاضلة</span>
        <span class="sub">من 30 درجة</span>
      </div>
      <output class="value" id="fin" aria-live="polite">—</output>
    </div>
  </section>

  <section class="panel" aria-labelledby="h-in">
    <h2 id="h-in">بياناتك</h2>
    <div class="fields">
      <div class="field">
        <label for="rank">تسلسل الطالب</label>
        <input id="rank" type="text" inputmode="numeric" autocomplete="off" placeholder="مثال: 5" value="5">
        <p class="hint">الأول = 1</p>
      </div>
      <div class="field">
        <label for="count">عدد الطلبة</label>
        <input id="count" type="text" inputmode="numeric" autocomplete="off" placeholder="مثال: 100" value="100">
        <p class="hint">طلبة دفعتك</p>
      </div>
      <div class="field">
        <label for="gpa">المعدل</label>
        <input id="gpa" type="text" inputmode="decimal" autocomplete="off" placeholder="مثال: 80" value="80">
        <p class="hint">من 100</p>
      </div>
    </div>
    <div class="actions">
      <button type="button" id="calc" class="primary">احسب</button>
      <button type="button" id="clear">مسح الحقول</button>
      <button type="button" id="example">إعادة المثال</button>
      <span class="note">الأرقام الظاهرة مثال، استبدلها بأرقامك.</span>
    </div>
    <div class="msgs" id="msgs" aria-live="polite"></div>
  </section>

  <section class="panel" aria-labelledby="h-f">
    <h2 id="h-f">المعادلة المعتمدة</h2>
    <div class="formula">
      <b>معدل أساس المفاضلة</b>
      <span>( 30 ÷ 100 ) × { [ 100 × ( 1 − تسلسل الطالب ÷ عدد الطلبة ) ] ÷ 2 + المعدل ÷ 2 }</span>
    </div>
  </section>

  <p class="sign bottom"><span>Designed by:</span> <span class="name">Dr.Zaid Saad</span></p>
</div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var AR = '٠١٢٣٤٥٦٧٨٩', FA = '۰۱۲۳۴۵۶۷۸۹';

  function num(s) {
    s = String(s == null ? '' : s)
      .replace(/[٠-٩]/g, function (d) { return AR.indexOf(d); })
      .replace(/[۰-۹]/g, function (d) { return FA.indexOf(d); })
      .replace(/[٫,،]/g, '.')
      .trim();
    if (s === '') return NaN;
    return Number(s);
  }
  function fmt(n) {
    return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  var ids = ['rank', 'count', 'gpa'];

  function setInvalid(id, bad) {
    if (bad) $(id).setAttribute('aria-invalid', 'true');
    else $(id).removeAttribute('aria-invalid');
  }
  function showMsgs(list) {
    var box = $('msgs');
    box.innerHTML = '';
    list.forEach(function (m) {
      var d = document.createElement('div');
      d.className = 'msg ' + m[0];
      d.textContent = m[1];
      box.appendChild(d);
    });
  }

  function render() {
    var v = {};
    ids.forEach(function (id) { v[id] = num($(id).value); setInvalid(id, false); });
    var msgs = [];
    var blank = ids.every(function (id) { return $(id).value.trim() === ''; });
    var ok = true;

    function bad(id, text) { ok = false; setInvalid(id, true); msgs.push(['bad', text]); }
    function notNum(id, label) {
      if (isNaN(v[id])) {
        ok = false;
        if ($(id).value.trim() !== '') bad(id, 'قيمة «' + label + '» ليست رقماً صحيحاً.');
        return true;
      }
      return false;
    }

    if (!notNum('rank', 'تسلسل الطالب') && (v.rank < 1 || Math.floor(v.rank) !== v.rank)) bad('rank', 'تسلسل الطالب يجب أن يكون عدداً صحيحاً من 1 فأكثر.');
    if (!notNum('count', 'عدد الطلبة') && (v.count < 1 || Math.floor(v.count) !== v.count)) bad('count', 'عدد الطلبة يجب أن يكون عدداً صحيحاً من 1 فأكثر.');
    if (!notNum('gpa', 'المعدل') && (v.gpa < 0 || v.gpa > 100)) bad('gpa', 'المعدل يجب أن يكون بين 0 و100.');
    if (ok && v.rank > v.count) bad('rank', 'تسلسل الطالب لا يمكن أن يكون أكبر من عدد الطلبة.');

    if (!ok) {
      $('fin').textContent = '—';
      showMsgs(blank ? [] : msgs);
      return;
    }

    var rankScore = 100 * (1 - v.rank / v.count);
    var avg = rankScore / 2 + v.gpa / 2;
    var fin = 30 / 100 * avg;
    $('fin').textContent = fmt(fin);
    showMsgs(msgs);
  }

  ids.forEach(function (id) {
    ['input', 'keyup', 'change', 'paste', 'compositionend'].forEach(function (ev) {
      $(id).addEventListener(ev, function () { setTimeout(render, 0); });
    });
  });
  $('calc').addEventListener('click', function () {
    render();
    if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
  });
  $('clear').addEventListener('click', function () {
    ids.forEach(function (id) { $(id).value = ''; });
    render();
    $('rank').focus();
  });
  $('example').addEventListener('click', function () {
    $('rank').value = '5'; $('count').value = '100'; $('gpa').value = '80';
    render();
  });

  render();
})();
</script>

</body>
</html>
